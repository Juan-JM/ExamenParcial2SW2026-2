APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=mongodb

CACHE_STORE=mongodb
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Asistente de IA del diagrama: solo modelo local (ver documentacion/06-asistente-ia.md).
AI_ASSISTANT_ENABLED=true

# =============== MONGODB (persistencia NoSQL) ===============
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE=diagramador

# =============== AGENTE IA ===============
AI_AGENT_NAME=Nova
AI_AGENT_WAKE_WORDS=nova,jarvis,yarvis,harvis,yervis,charvis
AI_AGENT_TIMEZONE=America/La_Paz
# Modelo local: LM Studio (puerto 1234) u Ollama (http://127.0.0.1:11434/v1).
AI_LOCAL_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODELS=qwen/qwen3.5-9b
LOCAL_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Notificaciones push: ruta al JSON de la cuenta de servicio de Firebase.
FCM_CREDENTIALS=

# Base vectorial (Qdrant) + modelo de embeddings local para la búsqueda semántica.
VECTOR_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=diagramador
